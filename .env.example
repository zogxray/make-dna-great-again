# LLM channel: aistudio | vertex (explicit choice — no silent failover).
# Prefer setting key + Cloud project in the app: F2 · Google Gemini · P.
LLM_PROVIDER_MODE=aistudio

# Optional env fallbacks if F2 fields are empty:
# GOOGLE_CLOUD_PROJECT=project-2257f100-507e-4707-858
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_CLOUD_QUOTA_PROJECT=project-2257f100-507e-4707-858
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json
# GEMINI_API_KEY=

# Models (used when F7 has no saved model yet; F6/F5 ASK use reasoning tier default)
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon
